# Frontend environment. Only VITE_* values are exposed to the browser: never put secrets here.
# AUTH_MODE: "dev" uses demo accounts (local only). "firebase" uses Firebase Authentication.
VITE_AUTH_MODE=dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_CONTACT_EMAIL=
