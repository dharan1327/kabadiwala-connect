# Copy to backend/.env and adjust. Never commit real secrets.
APP_ENV=development
DATABASE_URL=sqlite:///./kabadiwala.db
# For PostgreSQL: postgresql+psycopg2://kabadiwala:change-me@localhost:5432/kabadiwala
AUTH_MODE=dev                 # dev = demo header auth (local only); firebase = verify Firebase ID tokens
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=    # service-account JSON path; leave empty to use Application Default Credentials
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
CLASSIFIER_MODEL_PATH=        # path to a trained Keras model; empty = classifier reports "unavailable"
MATCH_RADIUS_KM=10
SEED_DEMO=true
